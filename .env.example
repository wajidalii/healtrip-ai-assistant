# Model credentials (server-only). The agent needs exactly one of these modes;
# everything else runs without them. Precedence: ANTHROPIC_API_KEY, then
# OPENAI_API_KEY, then AI_GATEWAY_API_KEY, then Vercel OIDC (no key at all when
# deployed on Vercel with OIDC federation enabled; VERCEL is set by the
# platform). See README "Credential modes" and docs/DECISIONS.md ADR-8/ADR-9.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=

# Optional: model for the OpenAI mode (Responses API id). Default shown.
OPENAI_MODEL=gpt-6.1-sol

# Optional: Claude model and effort. Defaults shown. Through the AI Gateway the
# id is mapped to a provider slug (claude-opus-5-5 -> anthropic/claude-opus-5.5);
# a value containing "/" is used as a gateway slug verbatim.
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
AGENT_MAX_STEPS=6

# Optional: PostgreSQL. When unset the app uses an in-memory repository seeded
# with the same data.
# DATABASE_URL=postgres://healtrip:healtrip@localhost:5432/healtrip

# Optional: rate limit for POST /api/conversations/:id/messages (per IP per minute)
RATE_LIMIT_PER_MINUTE=20
