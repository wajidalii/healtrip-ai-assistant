# Required for the agent (server-only). Everything else runs without it.
ANTHROPIC_API_KEY=

# Optional: Claude model and effort. Defaults shown.
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
AGENT_MAX_STEPS=6

# Optional: PostgreSQL. When unset the app uses an in-memory repository seeded
# with the same data.
# DATABASE_URL=postgres://healtrip:healtrip@localhost:5432/healtrip

# Optional: rate limit for POST /api/conversations/:id/messages (per IP per minute)
RATE_LIMIT_PER_MINUTE=20
